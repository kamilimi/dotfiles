# history
HISTFILE=~/.histfile
HISTSIZE=1000
SAVEHIST=1000
setopt HIST_IGNORE_ALL_DUPS
setopt SHARE_HISTORY

# default opts
setopt autocd
unsetopt beep

# vi-style editing mode
bindkey -v

# fix backspace in insert mode
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char


# loading plugins
source ~/.zsh-plugins/source.zsh


# prompt
PROMPT=' %3~ $ '

precmd() {
  print
}


# propably cool coloring
alias ls='ls --color=auto'
alias grep='grep --color=auto'

# added paths
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# home directories
export XDG_DATA_DIRS="$HOME/.local/share/my-apps/share:$XDG_DATA_DIRS"

# default file editor
export EDITOR="nvim"
export VISUAL="nvim"

# auto completion
autoload -Uz compinit
compinit

zstyle ':completion:*' menu yes select=2

